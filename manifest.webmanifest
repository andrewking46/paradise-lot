{
  "id": "./",
  "name": "Paradise Lot",
  "short_name": "Paradise Lot",
  "description": "Build a tropical resort in pixel art, from pools and slides to dolphin lagoons, for guests who say exactly what they think. Plays in the browser, offline too.",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["games", "entertainment"],
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": "focus-existing" },
  "orientation": "any",
  "background_color": "#121a38",
  "theme_color": "#121a38",
  "icons": [
    { "src": "icons/app-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/app-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/app-maskable-480.png", "sizes": "480x480", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "share/preview.png", "sizes": "1200x630", "type": "image/png", "form_factor": "wide", "label": "The demo resort, seen from above" },
    { "src": "share/phone.png", "sizes": "780x1560", "type": "image/png", "form_factor": "narrow", "label": "Building a resort on a phone" }
  ],
  "shortcuts": [
    { "name": "Continue", "description": "Carry on with the game played last", "url": "./?resume", "icons": [{ "src": "icons/app-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "New game", "description": "Choose where to build, and start", "url": "./?start", "icons": [{ "src": "icons/app-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-paradise-lot-save": [".plsave"] }, "launch_type": "single-client" }
  ]
}
